{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    // @unimem/okf ships a node:fs-backed BundleFs; without this the root pass
    // cannot resolve it, even though each package's own tsconfig can.
    "types": ["node"],
    "paths": {
      "@unimem/types": ["./packages/types/src"],
      "@unimem/core": ["./packages/core/src"],
      "@unimem/db": ["./packages/db/src"],
      "@unimem/okf": ["./packages/okf/src"],
      "@unimem/analytics": ["./packages/analytics/src"],
      "@unimem/analytics/browser": ["./packages/analytics/src/browser"]
    }
  },
  // Only the shared libraries, checked straight from source via `paths` above.
  //
  // Deliberately not a project-references build: with `references` the root
  // resolves cross-package imports through each package's emitted .d.ts, so a
  // clean tree fails with TS6305 until every package has been built. Reading
  // the sources directly means `pnpm typecheck` works from any state.
  //
  // Each app depends on types its framework generates - Nuxt's
  // `.nuxt/tsconfig.json`, Nitro's auto-imports, Electron's CommonJS module
  // layout - so each carries its own tsconfig, and `pnpm typecheck` runs the
  // ones that have a `typecheck` script.
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "**/dist", "**/node_modules"]
}
