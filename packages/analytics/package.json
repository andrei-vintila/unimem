{
  "name": "@unimem/analytics",
  "version": "0.1.0",
  "description": "Typed, privacy-constrained analytics contract for Unimem",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc && node --test test/"
  },
  "dependencies": {
    "@unimem/types": "workspace:*",
    "posthog-js": "^1.417.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
