{
  // Generated by `nitro prepare`. It supplies the auto-import declarations
  // (`defineEventHandler`, `createError`, `useRuntimeConfig`, the `utils/`
  // helpers) that the route handlers use without importing - without it every
  // one of them is an undefined name.
  "extends": "./.nitro/types/tsconfig.json",
  "compilerOptions": {
    // The generated config turns strict off; the rest of the monorepo is
    // strict and this code is written for it.
    "strict": true
  },
  // `.nitro` must not be excluded here: exclude filters include, and dropping
  // it would take the generated declarations with it.
  "include": ["**/*.ts", ".nitro/types/nitro.d.ts"],
  "exclude": ["node_modules", ".output"]
}
