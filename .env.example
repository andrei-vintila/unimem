# =============================================================================
# Unimem - Environment Variables
# =============================================================================
# Copy to `.env` and fill in. All values are optional; Unimem runs fully
# local-first without any of them.

# -----------------------------------------------------------------------------
# Analytics (PostHog)
# -----------------------------------------------------------------------------
# Project API key. Write-only and safe to expose in the client bundle.
# Leave empty to disable analytics entirely - the no-op client is used and
# nothing is sent. This is the default for local development.
NUXT_PUBLIC_POSTHOG_KEY=

# Ingestion host. Defaults to `/_ph`, the same-origin reverse proxy configured
# in apps/web/nuxt.config.ts. Override only when proxying elsewhere.
NUXT_PUBLIC_POSTHOG_HOST=/_ph

# PostHog's own UI, used for the toolbar link. EU Cloud by default.
NUXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
NUXT_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Sync server
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SYNC_SERVER_URL=
